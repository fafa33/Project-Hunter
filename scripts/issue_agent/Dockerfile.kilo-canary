FROM node:22-bookworm-slim
RUN npm install --global --ignore-scripts @kilocode/cli@7.8.18
COPY scripts/issue_agent/kilo_broker_client.cjs /usr/local/lib/hunter/kilo_broker_client.cjs
COPY scripts/issue_agent/kilo_broker_shell /usr/local/bin/hunter-governed-shell
RUN chmod 555 /usr/local/bin/hunter-governed-shell
USER 65534:65534
WORKDIR /workspace
ENTRYPOINT ["kilo"]
