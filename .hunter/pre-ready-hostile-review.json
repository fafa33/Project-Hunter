  "claims": {
    "acceptance_criteria": [
      {
        "criterion": "Free-provider capacity is inventoried with explicit provenance and observed consumption is persisted without paid API use.",
        "evidence": "No paid API path was added; bounded EVM RPC, CoinGecko completed-page cursors, and DexScreener retry accounting remain provenance-bound and no full repository suite was used as a local gate.",
        "id": "AC-587-01",
        "verdict": "satisfied"
      },
      {
        "criterion": "Global discovery uses bounded, resumable free capacity and truthful DexScreener batching without a parallel daemon.",
        "evidence": "Legacy chain aliases canonicalize for registry identity and cursors, batch retry attempts consume the supplied budget exactly once, and duplicate contract aliases no longer split bounded enrichment work.",
        "id": "AC-587-02",
        "verdict": "satisfied"
      },
      {
        "criterion": "Global coverage is evidence-bound and explicitly discloses inaccessible or unknown scope.",
        "evidence": "Per-log block binding, exact target-asset FIFO, full-receipt ambiguity, recipient ownership, normalized freshness, all row-derived signed metadata, and consideration-side causal USD valuation fail closed. Signed buy-input and sell-output valuation now lives in the onchain boundary so the market-validation boundary contains no buy/sell transaction-direction literals; focused boundary regression passes.",
        "id": "AC-587-03",
        "verdict": "satisfied"
      },
      {
        "criterion": "Governed review and publication remain exact-head-bound and non-merging until owner approval.",
        "evidence": "Fresh writer judgement after the hosted boundary failure on 538dc3dcca28f9b3848b920744c78b4617c6bcde; 63 focused tests, scoped Ruff/Black/mypy, registry JSON validation, no buy/sell token in src/hunter/market_validation, and no prior reviewer authority reused. Hosted exact-head gates remain authoritative and must re-verify the corrected head; PR #788 stays Draft with no merge or deployment asserted.",
        "id": "AC-587-04",
        "verdict": "satisfied"
      }
    ],
